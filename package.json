{
  "name": "notes-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "imports": {
    "#app/*": "./dist/*.js",
    "#modules/auth/*": "./dist/modules/auth/*.js",
    "#modules/users/*": "./dist/modules/users/*.js",
    "#modules/notes/*": "./dist/modules/notes/*.js",
    "#modules/shared/*": "./dist/modules/shared/*.js",
    "#modules/*": "./dist/modules/*.js"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "prepare": "husky",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:postgres": "TEST_DB_ENGINE=postgres vitest run --project integration --project e2e",
    "test:e2e:mongodb": "TEST_DB_ENGINE=mongodb vitest run --project integration --project e2e",
    "test:db": "bash scripts/test-db.sh",
    "db:test:up": "docker compose -f compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yml down -v",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "migrate": "tsx src/migrate.ts",
    "migrate:sqlite": "tsx src/migrate.ts sqlite",
    "migrate:postgres": "tsx src/migrate.ts postgres",
    "migrate:mongodb": "tsx src/migrate.ts mongodb"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
